# Скопируйте в deploy/regru/.env и заполните перед деплоем на REG.RU

# Домен relay API (A-запись → IP VPS)
DOMAIN=api.chat2chat.org

# VPS (деплой лендинга: bash deploy/regru/deploy-landing.sh)
VPS_HOST=161.104.17.85
VPS_PASSWORD=

# Маркетинговый лендинг (тот же VPS, отдельный vhost в Caddy)
SITE_DOMAIN=chat2chat.org

# Email для Let's Encrypt (Caddy)
ACME_EMAIL=admin@example.ru

# CORS — домен вашего веб-клиента (можно * для теста)
CORS_ORIGIN=https://relay.example.ru

# URL для сборки веб-UI (полный стек)
VITE_CHAT2CHAT_SERVER=wss://relay.example.ru/ws
VITE_CHAT2CHAT_HTTP=https://relay.example.ru

# Лимиты relay
MESSAGE_TTL_MS=86400000
BLOB_TTL_MS=86400000
MAX_BLOB_SIZE=536870912

# Minimum client version (relay rejects older builds at WebSocket register)
MIN_CLIENT_VERSION=1.5.3
MIN_CLIENT_BUILD=57
ENFORCE_MIN_CLIENT_VERSION=true

# SMTP — Mail.ru (recovery codes, developer download links)
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@chat2chat.org
SMTP_PASS=
SMTP_FROM=no-reply@chat2chat.org
DATA_DIR=/app/data
