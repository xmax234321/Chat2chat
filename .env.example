# Relay server
PORT=3847
HOST=0.0.0.0
CORS_ORIGIN=true

# Message queue TTL (24h)
MESSAGE_TTL_MS=86400000
BLOB_TTL_MS=86400000
MAX_BLOB_SIZE=536870912

# Web client (dev)
# VITE_CHAT2CHAT_SERVER=ws://localhost:3847/ws
# VITE_CHAT2CHAT_HTTP=http://localhost:3847

# SMTP (Mail.ru) — verification codes for recovery email
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=code@chat2chat.org
SMTP_PASS=
SMTP_FROM=code@chat2chat.org
