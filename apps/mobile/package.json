{
  "name": "@chat2chat/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Chat2Chat iOS app (Capacitor)",
  "scripts": {
    "build:web": "cross-env VITE_CAPACITOR=1 VITE_CHAT2CHAT_SERVER=wss://api.chat2chat.org/ws VITE_CHAT2CHAT_HTTP=https://api.chat2chat.org pnpm --filter @chat2chat/web build",
    "build:public": "cross-env VITE_CAPACITOR=1 VITE_CHAT2CHAT_SERVER=wss://api.chat2chat.org/ws VITE_CHAT2CHAT_HTTP=https://api.chat2chat.org pnpm --filter @chat2chat/web build && cap sync ios",
    "sync": "pnpm build:web && cap sync ios",
    "ios": "pnpm sync && cap open ios",
    "ios:run": "pnpm sync && cap run ios",
    "ios:public": "bash scripts/build-public-ios.sh",
    "ios:altstore": "bash scripts/build-altstore.sh",
    "altstore:source": "node scripts/generate-altstore-source.mjs",
    "cap": "cap"
  },
  "dependencies": {
    "@capacitor/app": "^7.0.1",
    "@capacitor/camera": "^7.0.1",
    "@capacitor/core": "^7.0.1",
    "@capacitor/filesystem": "^7.1.8",
    "@capacitor/haptics": "^7.0.1",
    "@capacitor/ios": "^7.0.1",
    "@capacitor/keyboard": "^7.0.1",
    "@capacitor/share": "^7.0.4",
    "@capacitor/splash-screen": "^7.0.1",
    "@capacitor/status-bar": "^7.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.1",
    "cross-env": "^7.0.3",
    "typescript": "^5.7.2"
  }
}
