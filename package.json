{
  "name": "chat2chat",
  "version": "0.1.0",
  "private": true,
  "description": "Private messenger with zero-storage server and E2E encryption",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "dev:server": "pnpm --filter @chat2chat/server dev",
    "start:server": "pnpm --filter @chat2chat/server start",
    "dev:web": "pnpm --filter @chat2chat/web dev",
    "dev:desktop": "pnpm --filter @chat2chat/desktop dev",
    "build:desktop": "pnpm --filter @chat2chat/desktop build",
    "ios": "pnpm --filter @chat2chat/mobile ios",
    "ios:run": "pnpm --filter @chat2chat/mobile ios:run",
    "ios:public": "pnpm --filter @chat2chat/mobile ios:public",
    "ios:altstore": "pnpm --filter @chat2chat/mobile ios:altstore",
    "build:ios": "pnpm --filter @chat2chat/mobile sync",
    "icons": "node scripts/generate-brand-icons.mjs",
    "demo": "pnpm --filter @chat2chat/demo start",
    "docker:up": "docker compose up relay --build -d",
    "docker:down": "docker compose down",
    "docker:full": "docker compose --profile full up --build -d",
    "deploy:regru": "bash deploy/regru/deploy.sh full",
    "deploy:landing": "bash deploy/regru/deploy-landing.sh",
    "build:site": "bash deploy/scripts/build-site-release.sh",
    "check:info-plist": "bash scripts/check-info-plist-security.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "sharp": "^0.35.3"
  }
}
